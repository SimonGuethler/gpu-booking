# Docker-Compose-Konfiguration (gpu-booking/compose.yaml)

# Nach außen veröffentlichte Host-Ports
FRONTEND_PORT=80
BACKEND_PORT=8000

# Postgres
POSTGRES_USER=gpu
POSTGRES_PASSWORD=gpu
POSTGRES_DB=gpu_booking

# Backend
JWT_SECRET=bitte-anderes-secret-setzen
JWT_EXPIRE_DAYS=90
# Bei HTTPS in Produktion auf true setzen.
AUTH_COOKIE_SECURE=false
# Maximale Buchungsdauer für reguläre Nutzer in ganzen Tagen. Admins sind ausgenommen.
MAX_BOOKING_DAYS=7
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# Frontend-API, beim Image-Build eingebettet. /api nutzt den nginx-Proxy im Compose-Stack.
# Für getrennte Deployments z. B. https://api.example.com/api setzen.
VITE_API_BASE_URL=/api

# Erster Admin (Seed läuft nur, wenn noch keine Nutzer existieren)
SEED_ADMIN_DISPLAY_NAME=Admin
SEED_ADMIN_PASSWORD=bitte-sicheres-passwort-setzen
SEED_ADMIN_EMAIL=admin@example.local
