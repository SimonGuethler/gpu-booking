# Nur für lokale Backend-Entwicklung ohne Docker Compose (`cd backend`).
# Der Compose-Stack verwendet stattdessen ../.env.example.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://gpu:gpu@localhost:5432/gpu_booking

# Auth
JWT_SECRET=bitte-anders-setzen
JWT_EXPIRE_DAYS=90
# Bei HTTPS in Produktion auf true setzen.
AUTH_COOKIE_SECURE=false

# Maximale Buchungsdauer für reguläre Nutzer in ganzen Tagen. Admins sind ausgenommen.
MAX_BOOKING_DAYS=7

# CORS (Frontend-Origins, kommasepariert)
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Erster Admin (Seed läuft nur, wenn noch keine Nutzer existieren)
SEED_ADMIN_DISPLAY_NAME=Admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.local
